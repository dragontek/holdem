{
  "id": "./",
  "name": "Jack Ten Poker — Tournament League",
  "short_name": "Jack Ten",
  "description": "Mobile-first Texas Hold'em tournament league clocks, standings, schedules, venues, and Director Desk.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020617",
  "theme_color": "#020617",
  "categories": ["sports", "games", "entertainment"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Games & Live Clocks",
      "short_name": "Games",
      "description": "View upcoming schedules and active tournament clocks",
      "url": "./",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "League Standings",
      "short_name": "Standings",
      "description": "Check season leaderboard points and rankings",
      "url": "./leaderboard",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Rules & Host Venues",
      "short_name": "Rules",
      "description": "Tournament blind structure, scoring rules, and partner venues",
      "url": "./info",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
