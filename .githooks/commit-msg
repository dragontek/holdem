#!/usr/bin/env sh
# Enforce Conventional Commits locally on every commit
NODE_BIN="node"
if ! "$NODE_BIN" -v >/dev/null 2>&1; then
  for candidate in /usr/local/Cellar/node@20/*/bin/node /opt/homebrew/opt/node@20/bin/node /opt/homebrew/bin/node; do
    if [ -x "$candidate" ] && "$candidate" -v >/dev/null 2>&1; then
      NODE_BIN="$candidate"
      break
    fi
  done
fi
"$NODE_BIN" scripts/validateCommitMsg.mjs --file "$1"
